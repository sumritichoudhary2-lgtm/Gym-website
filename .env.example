# Copy this file to .env and use your own Oracle connection details.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ORACLE_USER=fitzone_app
ORACLE_PASSWORD=replace-with-your-database-password
# Example: localhost:1521/FREEPDB1
ORACLE_DSN=localhost:1521/FREEPDB1
CURRENCY=USD
# Set true when serving over HTTPS in production.
COOKIE_SECURE=false
